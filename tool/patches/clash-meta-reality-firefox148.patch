index 00000000..1926b4fd
--- /dev/null
+++ b/component/tls/reality_pq_test.go
@@ -0,0 +1,49 @@
+package tls
+
+import (
+	"bytes"
+	"net"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func TestRealityPreservesFirefoxHybridKeyShare(t *testing.T) {
+	fingerprint, ok := GetFingerprint("firefox")
+	if !ok {
+		t.Fatal("firefox fingerprint is unavailable")
+	}
+
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+
+	conn := UClient(client, &utls.Config{ServerName: "example.com"}, fingerprint)
+	if err := buildRealityHandshakeState(conn); err != nil {
+		t.Fatalf("build REALITY ClientHello: %v", err)
+	}
+
+	for _, extension := range conn.Extensions {
+		keyShares, ok := extension.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		if len(keyShares.KeyShares) < 2 ||
+			keyShares.KeyShares[0].Group != utls.X25519MLKEM768 ||
+			keyShares.KeyShares[1].Group != utls.X25519 {
+			t.Fatalf("REALITY key shares = %v, want X25519MLKEM768 followed by X25519", keyShares.KeyShares)
+		}
+		return
+	}
+	t.Fatal("REALITY ClientHello has no key_share extension")
+}
+
+func TestRealityClientVersionBytes(t *testing.T) {
+	sessionID := make([]byte, 32)
+	setRealityClientVersion(sessionID)
+
+	want := []byte{26, 7, 11}
+	if !bytes.Equal(sessionID[:3], want) {
+		t.Fatalf("REALITY client version = %v, want %v", sessionID[:3], want)
+	}
+}
